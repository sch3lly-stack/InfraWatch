# Copy to .env and replace every value. Generate secrets with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me
INFRAWATCH_SECRET_KEY=change-me-48-random-bytes
INFRAWATCH_ADMIN_PASSWORD=change-me-too
# Set to true ONLY when running behind the Caddy proxy (so client IPs for rate limiting are correct)
INFRAWATCH_TRUST_PROXY_HEADERS=false
